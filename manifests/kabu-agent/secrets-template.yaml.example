###############################################################################
# IMPORTANT: This is a TEMPLATE file. DO NOT commit actual secrets to git.
#
# To create a Sealed Secret:
# 1. Fill in actual values and save as 'secrets.yaml' (DO NOT commit this file)
# 2. Run: kubeseal --format yaml < secrets.yaml > sealed-secrets.yaml
# 3. Commit only 'sealed-secrets.yaml' to git
# 4. Delete 'secrets.yaml' immediately
###############################################################################
apiVersion: v1
kind: Secret
metadata:
  name: kabu-secrets
  namespace: kabu-agent
type: Opaque
stringData:
  # Database
  postgres-user: "kabu_user"
  postgres-password: "CHANGE_ME_POSTGRES_PASSWORD"
  database-url: "postgresql://kabu_user:CHANGE_ME_POSTGRES_PASSWORD@postgres:5432/kabu_agent"

  # Redis
  redis-url: "redis://redis:6379/0"

  # KIS API (Korea Investment Securities)
  kis-app-key: "CHANGE_ME_KIS_APP_KEY"
  kis-app-secret: "CHANGE_ME_KIS_APP_SECRET"
  kis-account-number: "CHANGE_ME_ACCOUNT_NUMBER"

  # Google Gemini API
  gemini-api-key: "CHANGE_ME_GEMINI_API_KEY"

  # JWT
  jwt-secret: "CHANGE_ME_JWT_SECRET_MIN_32_CHARS"
